parm ../../04_traj/complex.parm7
trajin ../../04_traj/2us_nowat.nc

autoimage
rms first (@CA,C,O,N)
############# PCA
trajout pca.pdb pdb nobox onlyframes 1
average crdset prot-average
createcrd prot-trajectories
run
crdaction prot-trajectories rms ref prot-average (@CA,C,O,N)
crdaction prot-trajectories matrix covar name prot-covar (@CA,C,O,N)
runanalysis diagmatrix prot-covar out prot-evecs.dat vecs 3 name myEvecs nmwiz nmwizvecs 3 nmwizfile dna.nmd nmwizmask (@CA,C,O,N)
runanalysis modes eigenval name myEvecs out evalfrac.dat
crdaction prot-trajectories projection CPU modes myEvecs beg 1 end 3 (@CA,C,O,N) out pca.dat crdframes 1,last
hist CPU:1 bins 100 out prot-hist.agr norm name CPU-1
hist CPU:2 bins 100 out prot-hist.agr norm name CPU-2
hist CPU:3 bins 100 out prot-hist.agr norm name CPU-3
run
runanalysis hist CPU:1 CPU:2 free 300 bins 100 out pc1xpc2.gnu usemap
runanalysis hist CPU:1 CPU:3 free 300 bins 100 out pc1xpc3.gnu usemap
runanalysis hist CPU:2 CPU:3 free 300 bins 100 out pc2xpc3.gnu usemap
run

clear all
readdata prot-evecs.dat name Evecs
parm ../../04_traj/complex.parm7
parmstrip !(@CA,C,O,N)
parmwrite out prot-modes.parm7

####################################################
# Create a NetCDF trajectory file with the          #
# modes of motion of the first PCA                  #
#####################################################
runanalysis modes name Evecs trajout prot-mode1.nc pcmin -60 pcmax 60 tmode 1 trajoutmask @CA,C,O,N trajoutfmt netcdf
runanalysis modes name Evecs trajout prot-mode2.nc pcmin -60 pcmax 60 tmode 2 trajoutmask @CA,C,O,N trajoutfmt netcdf
runanalysis modes name Evecs trajout prot-mode1.pdb pcmin -80 pcmax 60 tmode 1 trajoutmask @CA,C,O,N trajoutfmt pdb
runanalysis modes name Evecs trajout prot-mode2.pdb pcmin -60 pcmax 60 tmode 2 trajoutmask @CA,C,O,N trajoutfmt pdb
