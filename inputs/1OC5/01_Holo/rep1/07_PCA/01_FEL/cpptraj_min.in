parm ../../04_traj/complex.parm7

trajin ../../04_traj/2us_nowat.nc
trajin ../../../rep2/04_traj/2us_nowat.nc
trajin ../../../rep3/04_traj/2us_nowat.nc

# Read PCA projections
# PC1 = pca.dat:2
# PC2 = pca.dat:3
readdata pca.dat

# ==========================================
# Free Energy Landscape — Minimum Extraction
# ==========================================

# ==========================================
# MIN1 — upper-left global minimum
# Deep blue core around:
# PC1 ≈ -15
# PC2 ≈ +22
# ==========================================
outtraj MIN1_core.nc \
maxmin pca.dat:2 min -25.00 max -10.00 \
maxmin pca.dat:3 min 17.00 max 28.00

# ==========================================
# MIN2 — right-side minimum
# Deep blue core around:
# PC1 ≈ +45
# PC2 ≈ +2
# ==========================================
outtraj MIN2_core.nc \
maxmin pca.dat:2 min 35.00 max 55.00 \
maxmin pca.dat:3 min -5.00 max 10.00

# ==========================================
# MIN3 — lower-left minimum
# Deep blue core around:
# PC1 ≈ -22
# PC2 ≈ -30
# ==========================================
outtraj MIN3_core.nc \
maxmin pca.dat:2 min -27.00 max -14.00 \
maxmin pca.dat:3 min -38.00 max -22.00

run
