parm ../../04_traj/complex.parm7
trajin ../../04_traj/2us_nowat.nc
trajin ../../../rep2/04_traj/2us_nowat.nc
trajin ../../../rep3/04_traj/2us_nowat.nc
autoimage
rms first

# ---- TRP chi1 (N-CA-CB-CG) ----
dihedral chi1_TRP10  :10@N  :10@CA  :10@CB  :10@CG  out TRP_chi1_combined.dat
dihedral chi1_TRP47  :47@N  :47@CA  :47@CB  :47@CG  out TRP_chi1_combined.dat
dihedral chi1_TRP100 :100@N :100@CA :100@CB :100@CG out TRP_chi1_combined.dat
dihedral chi1_TRP184 :184@N :184@CA :184@CB :184@CG out TRP_chi1_combined.dat
dihedral chi1_TRP187 :187@N :187@CA :187@CB :187@CG out TRP_chi1_combined.dat
dihedral chi1_TRP224 :224@N :224@CA :224@CB :224@CG out TRP_chi1_combined.dat
dihedral chi1_TRP278 :278@N :278@CA :278@CB :278@CG out TRP_chi1_combined.dat
dihedral chi1_TRP281 :281@N :281@CA :281@CB :281@CG out TRP_chi1_combined.dat
dihedral chi1_TRP307 :307@N :307@CA :307@CB :307@CG out TRP_chi1_combined.dat
dihedral chi1_TRP344 :344@N :344@CA :344@CB :344@CG out TRP_chi1_combined.dat

# ---- TRP chi2 (CA-CB-CG-CD1) ----
dihedral chi2_TRP10  :10@CA  :10@CB  :10@CG  :10@CD1  out TRP_chi2_combined.dat
dihedral chi2_TRP47  :47@CA  :47@CB  :47@CG  :47@CD1  out TRP_chi2_combined.dat
dihedral chi2_TRP100 :100@CA :100@CB :100@CG :100@CD1 out TRP_chi2_combined.dat
dihedral chi2_TRP184 :184@CA :184@CB :184@CG :184@CD1 out TRP_chi2_combined.dat
dihedral chi2_TRP187 :187@CA :187@CB :187@CG :187@CD1 out TRP_chi2_combined.dat
dihedral chi2_TRP224 :224@CA :224@CB :224@CG :224@CD1 out TRP_chi2_combined.dat
dihedral chi2_TRP278 :278@CA :278@CB :278@CG :278@CD1 out TRP_chi2_combined.dat
dihedral chi2_TRP281 :281@CA :281@CB :281@CG :281@CD1 out TRP_chi2_combined.dat
dihedral chi2_TRP307 :307@CA :307@CB :307@CG :307@CD1 out TRP_chi2_combined.dat
dihedral chi2_TRP344 :344@CA :344@CB :344@CG :344@CD1 out TRP_chi2_combined.dat

run
