parm ../../04_traj/complex.parm7
trajin ../../04_traj/2us_nowat.nc

readdata pca.dat

# MinA (right, deep core)
outtraj WT_MinA_core.nc maxmin pca.dat:2 min -10.00 max 50.00 maxmin pca.dat:3 min -20.00 max 20.00

# MinB (upper-left, deep core)
outtraj WT_MinB_core.nc maxmin pca.dat:2 min -55.00 max 10.00 maxmin pca.dat:3 min -55.00 max -35.00

# MinC (lower-left, deep core)
outtraj WT_MinC_core.nc maxmin pca.dat:2 min -65.00 max -20.00 maxmin pca.dat:3 min 15.00 max 55.00
