parm ../../04_traj/complex.parm7
trajin ../../04_traj/2us_nowat.nc
trajin ../../../rep2/04_traj/2us_nowat.nc
trajin ../../../rep3/04_traj/2us_nowat.nc
readdata pca.dat

# Wild Type Free Energy Landscape — Minimum Extraction
# Coordinates read from FEL (PC1 = pca.dat:2, PC2 = pca.dat:3)

# MinA — right basin (deep blue core, ~PC1: +15 to +50, PC2: -25 to +18)
outtraj WT_MinA_core.nc maxmin pca.dat:2 min 15.00 max 50.00 maxmin pca.dat:3 min -25.00 max 18.00

# MinB — upper-left basin (deep blue core, ~PC1: -65 to -45, PC2: +25 to +47)
outtraj WT_MinB_core.nc maxmin pca.dat:2 min -65.00 max -45.00 maxmin pca.dat:3 min 25.00 max 47.00

# MinC — lower-left basin (deep blue core, ~PC1: -55 to -15, PC2: -55 to -35)
outtraj WT_MinC_core.nc maxmin pca.dat:2 min -55.00 max -15.00 maxmin pca.dat:3 min -55.00 max -35.00
