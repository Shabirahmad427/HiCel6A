parm ../../04_traj/complex.parm7
reference ../../04_traj/equil10_nowat.rst7
trajin ../../04_traj/2us_nowat.nc
autoimage
rms first

# RMSD for prtoein PDB 87-450
rmsd r1 reference :1-360&@CA,C,O,N mass out 1RMSD_protein.dat
run
hist r1,*,*,.05 norm out 1RMSD_protein_hist.dat
run

# RMSD for complex PDB 87-451
rmsd r2 reference :1-361 mass out 1RMSD_complex.dat
run
hist r2,*,*,.05 norm out 1RMSD_complex_hist.dat
run

# RMSD for ligand PDB 451
rmsd r3 reference :361 mass out 1RMSD_ligand.dat
run
hist r3,*,*,.05 norm out 1RMSD_ligand_hist.dat
run

# RMSD for Loop1 PDB 174-191
rmsd r4 reference :84-101&@CA,C,O,N mass out 1RMSD_Loop1_174-191.dat
run
hist r4,*,*,.05 norm out 1RMSD_Loop1_174-191_hist.dat
run

# RMSD for Loop2 PDB 307-330
rmsd r5 reference :217-240&@CA,C,O,N mass out 1RMSD_Loop2_307-330.dat
run
hist r5,*,*,.05 norm out 1RMSD_Loop2_307-330_hist.dat
run

# RMSD for Loop3 PDB 355-391
rmsd r6 reference :265-301&@CA,C,O,N mass out 1RMSD_Loop3_355-391.dat
run
hist r6,*,*,.05 norm out 1RMSD_Loop3_355-391_hist.dat
run

# RMSD for Loop4 PDB 397-435
rmsd r7 reference :307-345&@CA,C,O,N mass out 1RMSD_Loop4_397-435.dat
run
hist r7,*,*,.05 norm out 1RMSD_Loop4_397-435_hist.dat
run
