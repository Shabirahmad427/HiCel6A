#input file for running PB and GB
&general
  startframe=80001, endframe=90000, interval=5, keep_files=0,
  receptor_mask=":1-360", ligand_mask=":361",
  strip_mask=:WAT,:HOH,:Na+,:Cl-,:K+,:Mg2+,:SOD,:CLA,
/
&gb
  igb=5, saltcon=0.150,
/
&decomp
  idecomp=2, dec_verbose=1, csv_format=0,
  print_res="1-361"
/



