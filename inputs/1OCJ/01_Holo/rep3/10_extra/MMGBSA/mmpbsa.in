### !de 20000 a 20000
Binding Free Energy - PB and GB
&general
 startframe=70000, endframe=80000, interval=2, keep_files=0,
 receptor_mask=":1-360", ligand_mask=":361", strip_mask=:WAT:SOD:CLA:Cl-:Na+,
/
&gb
 igb=5, saltcon=0.150,
/
#&pb
# istrng=0.15
#/
&decomp
 idecomp=2, dec_verbose=1, csv_format=0, print_res="1-361"
/
